# Aqara U200 — local configuration (copy to `.env`, never commit `.env`).
#
# These are YOUR account/device values, captured from your own app session
# (see docs/tutorials/02-capture-credentials.md). None of them are secrets the
# project ships — they identify your account and your lock.

# ── Aqara cloud account ──────────────────────────────────────────────────────
AQARA_REGION=EU                       # EU | CN | US ...
AQARA_APPID=<your-appid>
AQARA_APPKEY=<your-appkey>
AQARA_TOKEN=<your-jwt-token>          # short-lived; re-capture when it expires
AQARA_USER_ID=<your-user-id>
AQARA_PHONE_ID=<your-phone-id>
AQARA_CLIENT_ID=<your-fcm-client-id>

# ── Target lock ──────────────────────────────────────────────────────────────
AQARA_DEVICE_ID=<matt.xxxxxxxxxxxxxxxxxxxx>
AQARA_LOCK_MAC=<AA:BB:CC:DD:EE:FF>

# ── BLE transport (optional) ─────────────────────────────────────────────────
# ESP32-S3 HCI controller path for the Bumble transport, if used.
AQARA_ESP32_PORT=serial:/dev/cu.usbmodemXXXXXXX,115200

# ── Library behaviour (optional) ─────────────────────────────────────────────
# Verbose protocol tracing to stderr. Any non-empty value enables it.
#U200_DEBUG=1
#
# DANGER — disables TLS certificate and hostname verification for cloud calls.
# It removes protection against machine-in-the-middle interception of the
# session material that opens your door. Leave it unset. Only enable it, briefly
# and on a network you trust, if your machine's CA store is broken (a common
# fresh-macOS-Python problem). Accepted values: 1 | true | yes | on.
#U200_INSECURE_TLS=1
